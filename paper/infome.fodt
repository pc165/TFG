   <text:p text:style-name="P123"><text:span text:style-name="T134">Per implementar el joc, </text:span><text:span text:style-name="T116">es va desenvolupar </text:span><text:span text:style-name="T115">dues classes:</text:span><draw:frame draw:style-name="fr2" draw:name="Frame7" text:anchor-type="char" svg:y="0.508cm" svg:width="5.154cm" draw:z-index="19">
