     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P88">Estat de l’Art</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B2" office:value-type="string">
      <text:p text:style-name="P89">Buscar productes/aplicacions similars al que es proposa, caracteritzar-los i comparar-los</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.C2" office:value-type="string">
      <text:p text:style-name="P93"><text:span text:style-name="T31">5</text:span> h</text:p>
     </table:table-cell>
