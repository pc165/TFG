     <text:p text:style-name="P106"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1344_2265125796" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.5. Desenvolupament del joc<text:tab/>9</text:a></text:p>
     <text:p text:style-name="P106"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1511_2436468453" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">7.6. </text:a><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1511_2436468453" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">T</text:a><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1511_2436468453" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">estejar els diferents components del joc</text:a><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1511_2436468453" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:tab/>10</text:a></text:p>
     <text:p text:style-name="P106"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1513_2436468453" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">TODO:<text:tab/>10</text:a></text:p>
     <text:p text:style-name="P106"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1136_1922039451" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Bibliografia y referències<text:tab/>11</text:a></text:p>
