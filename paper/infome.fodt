      <text:p text:style-name="P89"><text:span text:style-name="T138">100</text:span><text:span text:style-name="T136"> </text:span>%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A3" office:value-type="string">
      <text:p text:style-name="P139"><text:span text:style-name="T139">Disseny </text:span><text:span text:style-name="T138">i d</text:span><text:span text:style-name="T35">esevolupament</text:span> de <text:span text:style-name="T126">les classes principals del</text:span><text:span text:style-name="T34"> joc</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B3" office:value-type="string">
      <text:p text:style-name="P180"><text:span text:style-name="T139">Dissenyar </text:span><text:span text:style-name="T138">i i</text:span><text:span text:style-name="T35">mplementar</text:span> <text:span text:style-name="T126">la classe </text:span>de renderització amb OpenGL, implementar les rutines de tractament de les accions dels perifèrics </text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.C3" office:value-type="string">
      <text:p text:style-name="P93"><text:span text:style-name="T35">1</text:span><text:span text:style-name="T39">5</text:span><text:span text:style-name="T34">0</text:span> h</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D3" office:value-type="string">
      <text:p text:style-name="P93"><text:span text:style-name="T138">100</text:span><text:span text:style-name="T126"> </text:span>%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A3" office:value-type="string">
      <text:p text:style-name="P140"><text:span text:style-name="T138">D</text:span><text:span text:style-name="T28">isseny </text:span><text:span text:style-name="T138">i d</text:span><text:span text:style-name="T133">esenvolupament</text:span><text:span text:style-name="T104"> del joc</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B3" office:value-type="string">
      <text:p text:style-name="P180">Dissenyar <text:span text:style-name="T138">i i</text:span>mplementar <text:span text:style-name="T138">les classes que gestionen</text:span> <text:span text:style-name="T138">la </text:span>lògica i les funcionalitats principals del joc.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.C3" office:value-type="string">
      <text:p text:style-name="P98"><text:span text:style-name="T133">5</text:span>0 h</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D3" office:value-type="string">
      <text:p text:style-name="P98"><text:span text:style-name="T138">100</text:span> %</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A3" office:value-type="string">
      <text:p text:style-name="P97">Testejar els diferents components del joc</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B3" office:value-type="string">
      <text:p text:style-name="P96"><text:span text:style-name="T34">T</text:span>ests per a cada component <text:span text:style-name="T35">implementat</text:span>.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.C3" office:value-type="string">
      <text:p text:style-name="P96"><text:span text:style-name="T29">3</text:span>0 h</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D3" office:value-type="string">
      <text:p text:style-name="P96"><text:span text:style-name="T138">100</text:span> %</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A6" office:value-type="string">
      <text:p text:style-name="P88">Memòria i Presentació</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.B6" office:value-type="string">
      <text:p text:style-name="P89">Escriure la memòria i la presentació oral</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.C6" office:value-type="string">
      <text:p text:style-name="P93">10 h</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D6" office:value-type="string">
      <text:p text:style-name="P89"><text:span text:style-name="T138">100</text:span> %</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table4.1">
     <table:table-cell table:style-name="Table4.A6" table:number-columns-spanned="3" office:value-type="string">
      <text:p text:style-name="P89">GRAU DE MADURESA:</text:p>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:table-cell table:style-name="Table4.D7" office:value-type="string">
      <text:p text:style-name="P99"><text:span text:style-name="T138">100</text:span><text:span text:style-name="T137"> </text:span>%</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P76">Taula 1. Planificació de tasques del projecte.</text:p>
   <text:list xml:id="list3525460027486" text:continue-numbering="true" text:style-name="WWNum1">
    <text:list-item>
     <text:h text:style-name="P169" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1122_1922039451"/>Metodologia<text:bookmark-end text:name="__RefHeading___Toc1122_1922039451"/></text:h>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P151">Per a poder optimitzar al màxim els recursos necessaris, <text:span text:style-name="T138">es seguira </text:span>una metodologia àgil, celebrant revisions periòdiques generals en finalitzar cada sprint on es veur<text:span text:style-name="T138">an </text:span>els resultats de la fase anterior, valorar<text:span text:style-name="T75">à</text:span><text:span text:style-name="T138">n </text:span>els avenços <text:span text:style-name="T138">realizats </text:span>i es planificar<text:span text:style-name="T75">à</text:span><text:span text:style-name="T76">n</text:span> el següent sprint, concretament, <text:span text:style-name="T138">s’</text:span>utilitza<text:span text:style-name="T138">r</text:span><text:span text:style-name="T76">à</text:span> una tècnica anomenada Kanban, es dividiran les tasques en diferents subtasques i es col·locarà cada tasca segons el progrés (<text:span text:style-name="T37">todo, in progress and done</text:span>). En particular, és fara servir KanbanFlow per gestionar les subtasques. S&apos;utilitzarà el programari git per fer un control de versió del codi font del joc i Github per hostejar el codi font. Se seguirà una metodologia àgil, concretament, s&apos;utilitzarà una tècnica anomenada Kanban, </text:p>
   <text:list xml:id="list3525730168528" text:continue-numbering="true" text:style-name="WWNum1">
    <text:list-item>
     <text:h text:style-name="P172" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1332_2265125796"/><text:span text:style-name="T63">E</text:span><text:span text:style-name="T64">stat de l’art</text:span><text:bookmark-end text:name="__RefHeading___Toc1332_2265125796"/></text:h>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P158">En l&apos;actualitat, podem trobar sudokus en moltes parts: en els diaris, en llibres de passatemps, en aplicacions per al mòbil o ordinador. Tot i això, no s&apos;ha pogut trobar un sudoku en braille per a ordinador que permeti aprendre els números en braille o qualsevol joc semblant. És per això que s&apos;ha proposat a dur a terme aquest projecte.</text:p>
   <text:p text:style-name="P159"><text:span text:style-name="T118">El joc haurà de tenir com a mínim </text:span><text:span text:style-name="T117">4 botons per completar els objectius.</text:span></text:p>
   <text:list xml:id="list2564768396" text:style-name="L3">
    <text:list-item>
     <text:p text:style-name="P153">Un boto per guardar la partida.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P153">Un boto per carregar la partida.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P153">Un boto per cambiar de braïlle a numèric.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P153">Un boto per activar el solucionador interactiu. Aquesta constarà de dues fleches que permetrà al jugador avançar i retrocedir en la solució.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P134">Tots aquets elements tindr<text:span text:style-name="T113">àn tecles d’accés ràpid per millorar la comoditat i l’accesibilitat.</text:span></text:p>
   <text:list xml:id="list3525781144928" text:continue-list="list3525730168528" text:style-name="WWNum1">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:h text:style-name="P173" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1338_2265125796"/><text:span text:style-name="T140">Disseny i d</text:span>esevolupament de les classes principals del jo<text:span text:style-name="T129">c</text:span><text:bookmark-end text:name="__RefHeading___Toc1338_2265125796"/></text:h>
       <text:list>
        <text:list-item>
         <text:h text:style-name="P175" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1340_2265125796"/>Part <text:span text:style-name="T137">1</text:span><text:bookmark-end text:name="__RefHeading___Toc1340_2265125796"/></text:h>
        </text:list-item>
       </text:list>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P62">Un joc, normalment, està format per tres grans components (motor de renderització, motor de física i una llibreria matemàtica) que interactuen entre si per tal de permetre la <text:span text:style-name="T65">interacció amb les entitats del joc. En el nostre cas, degut a que no implementarem un joc molt complex, </text:span><text:span text:style-name="T68">només implementarem les funcionalitats que facin falta, es a dir un sistema per renderitzar objectes, un sistema d’esdeveniments per gestionar la E/S de l’usuari i </text:span><text:span text:style-name="T71">si fa falta </text:span><text:span text:style-name="T68">un sistema de col·lisions.</text:span></text:p>
   <text:p text:style-name="P62"><text:soft-page-break/><text:span text:style-name="T84">Primer de tot, </text:span><text:span text:style-name="T85">s´ha creat unes funcions que s&apos;encarreguen de la inicialització i destrucció de</text:span><text:span text:style-name="T86">l context OpenGL i de la finestra per on renderitzarem els nostres resultats</text:span><text:span text:style-name="T85">. </text:span><text:span text:style-name="T131">Seguidament, s’ha definit unes classes </text:span><text:span text:style-name="T132">(</text:span><text:span text:style-name="T38">VertexBuffer, IndexBuffer</text:span><text:span text:style-name="T130"> <text:s/>i </text:span><text:span text:style-name="T38">VertexArrayBuffer</text:span><text:span text:style-name="T132">) </text:span><text:span text:style-name="T131">que abstreuen els </text:span><text:span text:style-name="T132">diferents </text:span><text:span text:style-name="T131">buffers d’OpenGL per tal de poder més còmodament, </text:span><text:span text:style-name="T132">aquesta classe t</text:span><text:span text:style-name="T87">é una </text:span><text:span text:style-name="T93">rutina </text:span><text:span text:style-name="T94">molt important (</text:span><text:span text:style-name="T102">draw</text:span><text:span text:style-name="T103">)</text:span><text:span text:style-name="T102"> que </text:span><text:span text:style-name="T93">serveix per pintar l’objecte en pantalla </text:span><text:span text:style-name="T94">i es crida en cada refresc de la pantalla</text:span><text:span text:style-name="T131">.</text:span><text:span text:style-name="T102"> </text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T72">Per una altra banda</text:span><text:span text:style-name="T67">, </text:span><text:span text:style-name="T66">s’ha implementat una classe </text:span><text:span text:style-name="T97">Shader</text:span><text:span text:style-name="T89"> </text:span><text:span text:style-name="T66">que s’encarrega de comprovar si hi ha errors en el shader i de inicialitzar el programa shader. </text:span><text:span text:style-name="T72">L</text:span><text:span text:style-name="T69">a classe</text:span><text:span text:style-name="T96">,</text:span><text:span text:style-name="T69"> </text:span><text:span text:style-name="T72">també </text:span><text:span text:style-name="T66">implementa mètodes </text:span><text:span text:style-name="T67">per assignar les diferents variables </text:span><text:span text:style-name="T98">uniform </text:span><text:span text:style-name="T67">(int, float, vec3, mat4, etc).</text:span></text:p>
   <text:p text:style-name="P69"><text:span text:style-name="T67">E</text:span><text:span text:style-name="T65">n quant al sistema d’esdeveniments, s’ha creat una classe anomenada </text:span><text:span text:style-name="T95">Event </text:span><text:span text:style-name="T65">la qual es heretada per els diferents tipus d’events (</text:span><text:span text:style-name="T95">MouseMoveEvent, MouseButtonEvent, KeyEvent,WindowCloseEvent </text:span><text:span text:style-name="T88">i </text:span><text:span text:style-name="T95">WindowResizeEvent</text:span><text:span text:style-name="T65">), </text:span><text:span text:style-name="T70">també </text:span><text:span text:style-name="T73">s’</text:span><text:span text:style-name="T69">ha </text:span><text:span text:style-name="T71">implementat </text:span><text:span text:style-name="T69">una funció que instal·la els </text:span><text:span text:style-name="T99">callbacks </text:span><text:span text:style-name="T69">a</text:span><text:span text:style-name="T71">l sistema d’events del GLFW</text:span><text:span text:style-name="T69">.</text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="T77">U</text:span><text:span text:style-name="T79">na vegada desenvolupat el sistema </text:span><text:span text:style-name="T80">d’esdeveniments </text:span><text:span text:style-name="T79">i les classes bàsiques per renderitzar, es va implementar una </text:span><text:span text:style-name="T81">classe </text:span><text:span text:style-name="T100">Camera </text:span><text:span text:style-name="T91">que controla el la visualització del joc. </text:span></text:p>
   <text:p text:style-name="P36"><text:span text:style-name="T91">La classe </text:span><text:span text:style-name="T100">Camera </text:span><text:span text:style-name="T91">incorpora una funció que permet actualitzar l’estat apartir dels events del </text:span><text:span text:style-name="T79">teclat i el ratolí. </text:span><text:span text:style-name="T83">Finalment</text:span><text:span text:style-name="T82">, es va implementar la classe </text:span><text:span text:style-name="T101">Object </text:span><text:span text:style-name="T92">que permet renderitzar </text:span><text:span text:style-name="T82">un cub amb les transformacións que vulguis.</text:span></text:p>
   <text:p text:style-name="P35"><draw:frame draw:style-name="fr3" draw:name="Frame2" text:anchor-type="char" svg:y="0.215cm" svg:width="10.082cm" draw:z-index="13">
     <draw:text-box fo:min-height="6.304cm">
      <text:p text:style-name="P130"><draw:frame draw:style-name="fr7" draw:name="Image1" text:anchor-type="paragraph" svg:width="9.326cm" style:rel-width="87%" svg:height="6.419cm" style:rel-height="scale" draw:z-index="14"><draw:image draw:mime-type="image/png">
